# Credenciais de acesso ao SocialPack AI
AUTH_EMAIL=demo@socialpack.ai
AUTH_PASSWORD=socialpack123

# Segredo usado para assinar o cookie de sessão (JWT). Use 32+ caracteres aleatórios.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32-caracteres

# Supabase (Opcional - caso ausente, o sistema ativa fallback automático para data/packs.json)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada

