# Supabase Público (acessível no client e server)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Supabase Administrativo (apenas no servidor - NUNCA expor no client)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# UUID da conta demo da landing (somente servidor; vazio omite #exemplos)
DEMO_USER_ID=

# Configuração da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Limite de uso por usuário (somente servidor, opcional).
# Se a variável faltar ou o valor for inválido, vale o padrão do código.
# Geração semanal: 4 por hora e 12 por dia. ZIP do histórico: 6 por hora e 24 por dia.
# RATE_LIMIT_WEEKLY_PER_HOUR=4
# RATE_LIMIT_WEEKLY_PER_DAY=12
# RATE_LIMIT_HISTORY_ZIP_PER_HOUR=6
# RATE_LIMIT_HISTORY_ZIP_PER_DAY=24
