# Supabase Público (acessível no client e server)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Supabase Administrativo (apenas no servidor - NUNCA expor no client)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# UUID da conta demo da landing (somente servidor; vazio omite #exemplos)
DEMO_USER_ID=

# Configuração da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integração Asaas Cobranças (servidor apenas)
# Em sandbox, chaves começam com $aact_hmlg_
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox
